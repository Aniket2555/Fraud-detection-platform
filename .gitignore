# Local Spark / MLflow run artifacts (created when running pytest/training
# scripts locally outside Databricks or Azure ML — e.g. `pytest databricks/tests/`
# spins up a local SparkSession, and ml/training/*.py + ml/pipelines/*.py call
# mlflow.start_run() without a remote tracking URI)
spark-warehouse/
mlruns/
mlartifacts/

# Local dataset downloads (producers/transaction_producer/config.py defaults
