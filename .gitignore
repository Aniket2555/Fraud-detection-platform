# Real backend config (contains the actual state-storage account name) --
# keep only backend-*.conf.example checked in, see infrastructure/backend-dev.conf.example
backend-*.conf
!backend-*.conf.example
# Locally-generated secrets -- never commit
.sql_admin_password.local
kaggle.json
.kaggle/
# .terraform.lock.hcl is intentionally NOT ignored -- it pins provider
# versions like a lockfile and should be committed.

# Databricks & PySpark
.databricks/
dbfs/
*.db
metastore_db/
derby.log

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.target/
.mypy_cache/
.ruff_cache/

# Local Spark / MLflow run artifacts (created when running pytest/training
# scripts locally outside Databricks or Azure ML — e.g. `pytest databricks/tests/`
# spins up a local SparkSession, and ml/training/*.py + ml/pipelines/*.py call
# mlflow.start_run() without a remote tracking URI)
spark-warehouse/
mlruns/
mlartifacts/

# Local dataset downloads (producers/transaction_producer/config.py defaults
# to data/creditcard.csv; IEEE-CIS CSVs are similarly large and external —
# never meant to be committed)
data/

# Jupyter
.ipynb_checkpoints/

